# Development Dockerfile for MinerU VLM Web API
FROM lmsysorg/sglang:v0.4.7-cu124

# 接收构建参数
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

WORKDIR /app

# 安装系统依赖 (包含开发工具)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        git \
        wget \
        curl \
        python3-venv \
        vim \
        htop \
        tree && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 创建并激活虚拟环境
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# 升级 pip, setuptools, wheel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 复制并安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 开发环境使用自动下载模式，不在镜像中包含模型
ENV MINERU_MODEL_SOURCE=auto

# 复制模型下载脚本和启动脚本，其他文件通过 volume 挂载
COPY model_download.py /app/model_download.py
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# 创建必要目录
RUN mkdir -p /app/output /app/logs /app/temp

# 暴露端口
EXPOSE 8000

# 开发环境的健康检查更宽松
HEALTHCHECK --interval=60s --timeout=15s --start-period=180s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# 设置入口点
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8000"] 