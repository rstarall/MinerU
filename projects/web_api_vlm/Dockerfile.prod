# Production Dockerfile for MinerU VLM Web API
FROM lmsysorg/sglang:v0.4.7-cu124

# 接收构建参数
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ARG PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST}

WORKDIR /app

# 安装系统依赖
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        git \
        wget \
        curl \
        python3-venv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# 创建并激活虚拟环境
RUN python3 -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# 升级 pip, setuptools, wheel
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# 复制并安装 Python 依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 下载模型 (生产环境包含在镜像中)
RUN python -c "import os; os.system('mineru-models-download -s modelscope -m all'); print('Models downloaded successfully')"

# 设置模型源为本地
ENV MINERU_MODEL_SOURCE=local

# 复制应用文件
COPY app.py /app/app.py
COPY model_download.py /app/model_download.py
COPY entrypoint.sh /app/entrypoint.sh
COPY mineru.json /root/mineru.json

# 设置执行权限
RUN chmod +x /app/entrypoint.sh

# 创建必要目录
RUN mkdir -p /app/output /app/logs /app/temp

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 设置入口点
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--host", "0.0.0.0", "--port", "8000"] 